{
  "$schema": "./source/schema.json",
  "family_name": "Maple Mono",
  "infinite_arrow": false,
  "use_hinted": false,
  "pool_size": 4,
  "enable_ligature": false,
  "ttfautohint_param": {},
  "weight_mapping": {
    "thin": 100,
    "extralight": 200,
    "light": 300,
    "regular": 400,
    "semibold": 500,
    "medium": 600,
    "bold": 700,
    "extrabold": 800
  },
  "feature_freeze": {
    "cv01": "enable",
    "cv02": "enable",
    "cv03": "enable",
    "cv04": "enable",
    "cv05": "enable",
    "cv06": "enable",
    "cv07": "enable",
    "cv08": "enable",
    "cv09": "enable",
    "cv10": "enable",
    "cv31": "enable",
    "cv32": "enable",
    "cv33": "enable",
    "cv34": "enable",
    "cv35": "enable",
    "cv36": "enable",
    "cv37": "enable",
    "cv38": "enable",
    "cv39": "enable",
    "cv40": "enable",
    "cv41": "enable",
    "cv42": "enable",
    "cv43": "enable",
    "cv61": "disable",
    "cv62": "enable",
    "cv63": "enable",
    "cv64": "enable",
    "cv65": "enable",
    "cv96": "enable",
    "cv97": "enable",
    "cv98": "enable",
    "cv99": "enable",
    "ss01": "enable",
    "ss02": "disable",
    "ss03": "enable",
    "ss04": "enable",
    "ss05": "enable",
    "ss06": "enable",
    "ss07": "enable",
    "ss08": "disable",
    "ss09": "disable",
    "ss10": "disable",
    "ss11": "disable",
    "zero": "enable"
  },
  "nerd_font": {
    "enable": true,
    "version": "3.4.0",
    "mono": true,
    "propo": false,
    "use_font_patcher": false,
    "glyphs": ["--complete"],
    "extra_args": []
  },
  "cn": {
    "enable": true,
    "with_nerd_font": true,
    "fix_meta_table": true,
    "clean_cache": false,
    "narrow": false,
    "use_hinted": false,
    "use_static_base_font": true,
    "scale_factor": 1.0
  }
}
